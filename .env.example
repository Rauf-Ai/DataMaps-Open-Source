# Database
DATABASE_URL=sqlite:////data/app.db
DUCKDB_PATH=/data/organizations.duckdb

# JWT
SECRET_KEY=change-me-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost/dashboard
# Включайте только после активации автоплатежей менеджером ЮKassa.
YOOKASSA_RECURRING_ENABLED=false

# SMTP
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=noreply@datamaps.ru

# App
APP_URL=http://localhost:8080
LOCAL_MODE=true
REQUIRE_EMAIL_VERIFICATION=false
ADMIN_EMAIL=admin@datamaps.ru
FREE_CREDITS_ON_REGISTER=0
EXPORT_FILE_TTL_HOURS=24
EXPORT_MAX_ROWS=200000

# Paths
CSV_DIR=/data/csv
EXPORT_DIR=/data/exports

# Папка на ХОСТЕ, где лежат 1554 *.csv. Она будет смонтирована в контейнер как /data/csv (read-only).
# Пример (macOS):
#   CSV_SOURCE_DIR=/absolute/path/to/your/csv
CSV_SOURCE_DIR=./examples/demo_csv

# LLM для AI-сводок отзывов (OpenAI-совместимый API)
# Бесплатный старт: зарегистрируйтесь на https://openrouter.ai, создайте key,
# модель `deepseek/deepseek-chat:free` доступна без оплаты (~20 req/min).
# Когда будет бюджет — переключитесь на платный DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#   LLM_API_KEY=<ваш ключ из platform.deepseek.com>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat:free
LLM_TIMEOUT=60
STT_MODEL=openai/whisper-large-v3

# Тарификация анализа отзывов: цена_базовая * N_орг + цена_за_отзыв * N_отзывов
# Базовая цена — для быстрого режима (HTTP, до 50 отзывов).
# Глубокий режим (Playwright со скроллом, до 200 отзывов) — отдельная цена.
REVIEWS_PRICE_BASE=5
REVIEWS_PRICE_BASE_DEEP=15
REVIEWS_PRICE_PER_REVIEW=0.1

# Живой парсинг карт (см. также раздел деплоя). Ключ Яндекса — обязателен для
# «живого поиска» по Яндекс Картам и Google Maps.
YANDEX_SEARCH_API_KEY=

# ИИ-агент техподдержки + Telegram-бот для подтверждения действий.
# 1) Создайте бота через @BotFather → TELEGRAM_BOT_TOKEN.
# 2) Узнайте свой chat_id (например, @userinfobot) → TELEGRAM_ADMIN_CHAT_ID.
# 3) Сгенерируйте секрет: openssl rand -hex 32 → TELEGRAM_WEBHOOK_SECRET.
# 4) Установите webhook (см. deploy/README.deploy.md).
# Модель поддержки — дешёвый DeepSeek; если пусто, используется LLM_MODEL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Имя модели должно соответствовать провайдеру LLM_BASE_URL:
#   OpenRouter        → deepseek/deepseek-v4-flash
#   прямой DeepSeek   → deepseek-chat
SUPPORT_LLM_MODEL=deepseek/deepseek-v4-flash
SUPPORT_GUEST_DAILY_LIMIT=20
# Загрузка фото в чат поддержки (папка внутри /data, лимит размера в МБ)
SUPPORT_UPLOAD_DIR=/data/support_uploads
SUPPORT_MAX_UPLOAD_MB=8
